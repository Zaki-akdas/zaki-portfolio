# Copy to .env.local for local overrides — everything is optional in development.

# Admin panel password (overrides the one stored in data/auth.json).
# REQUIRED in production — set a strong password.
ADMIN_PASSWORD=

# Secret used to sign admin session cookies.
# REQUIRED in production — any long random string (e.g. `openssl rand -hex 32`).
AUTH_SECRET=

# Where JSON content lives. Point at a persistent disk in production.
# Local default: ./data
DATA_DIR=

# Where media uploads live. Point at a persistent disk in production.
# Local default: ./public/uploads
UPLOADS_DIR=

# Canonical public site URL (e.g. https://yourdomain.com). Used for
# sitemap.xml, robots.txt, metadataBase and social share images when the admin
# "Site URL" setting is not set. Without either, these fall back to a
# placeholder — set this in production.
NEXT_PUBLIC_SITE_URL=

# Postgres TLS: certificate verification is ON by default.
# Set to 1 ONLY for database hosts with self-signed certificates.
DATABASE_TLS_INSECURE=
